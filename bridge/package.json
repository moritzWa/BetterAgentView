{
  "name": "agentview-mobile-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "node contracts/generate.mjs",
    "contracts:check": "node contracts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run contracts:check && npm run typecheck",
    "test": "node --test test/*.test.mjs",
    "predeploy": "npm test",
    "deploy": "node release/deploy.mjs",
    "verify:live": "node release/live.mjs",
    "prebuild": "npm run contracts:check && npm run typecheck",
    "build": "wrangler deploy --config wrangler.private.jsonc --dry-run --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neondatabase/serverless": "^1.2.1",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "26.6.6",
    "quicktype-core": "26.0.0",
    "typescript": "5.9.3",
    "wrangler": "^4.162.0"
  }
}
