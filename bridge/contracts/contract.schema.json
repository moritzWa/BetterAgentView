{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "RuntimeSnapshot": {
      "$ref": "#/definitions/RuntimeSnapshot"
    },
    "Message": {
      "$ref": "#/definitions/Message"
    },
    "Session": {
      "$ref": "#/definitions/Session"
    },
    "Batch": {
      "$ref": "#/definitions/Batch"
    },
    "ReadContext": {
      "$ref": "#/definitions/ReadContext"
    },
    "CursorPointer": {
      "$ref": "#/definitions/CursorPointer"
    },
    "CursorRequest": {
      "$ref": "#/definitions/CursorRequest"
    },
    "CheckedRequest": {
      "$ref": "#/definitions/CheckedRequest"
    },
    "EmptyRequest": {
      "$ref": "#/definitions/EmptyRequest"
    },
    "AckRequest": {
      "$ref": "#/definitions/AckRequest"
    },
    "StartAckRequest": {
      "$ref": "#/definitions/StartAckRequest"
    },
    "VerifyRequest": {
      "$ref": "#/definitions/VerifyRequest"
    },
    "PairStart": {
      "$ref": "#/definitions/PairStart"
    },
    "PairToken": {
      "$ref": "#/definitions/PairToken"
    },
    "ArtifactUpload": {
      "$ref": "#/definitions/ArtifactUpload"
    }
  },
  "required": [
    "RuntimeSnapshot",
    "Message",
    "Session",
    "Batch",
    "ReadContext",
    "CursorPointer",
    "CursorRequest",
    "CheckedRequest",
    "EmptyRequest",
    "AckRequest",
    "StartAckRequest",
    "VerifyRequest",
    "PairStart",
    "PairToken",
    "ArtifactUpload"
  ],
  "additionalProperties": false,
  "definitions": {
    "RuntimeSnapshot": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "truncated": {
          "default": false,
          "type": "boolean"
        },
        "statuses": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuntimeStatus"
          }
        }
      },
      "required": [
        "available",
        "partial",
        "truncated",
        "statuses"
      ],
      "additionalProperties": false
    },
    "RuntimeStatus": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/definitions/Status"
        },
        "completion": {
          "$ref": "#/definitions/Completion"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/definitions/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "can_message": {
          "type": "boolean"
        },
        "last_user_message_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "last_user_ms": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "top_level": {
          "default": true,
          "type": "boolean"
        },
        "attention_assessed": {
          "default": false,
          "type": "boolean"
        },
        "directory": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "$ref": "#/definitions/Health"
        },
        "turn_started_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "last_progress_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "last_progress_kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProgressKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "in_flight": {
          "anyOf": [
            {
              "$ref": "#/definitions/InFlight"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "status",
        "completion",
        "reason",
        "updated_at",
        "can_message",
        "last_user_message_id",
        "last_user_ms",
        "top_level",
        "attention_assessed",
        "directory",
        "health"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "string",
      "enum": [
        "working",
        "needs_you",
        "done",
        "scheduled",
        "unknown"
      ]
    },
    "Completion": {
      "default": "unconfirmed",
      "type": "string",
      "enum": [
        "unconfirmed",
        "task_done",
        "project_done"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "question",
        "approval",
        "failed",
        "reply"
      ]
    },
    "Health": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "running",
        "idle",
        "potentially_stalled",
        "failed",
        "unknown"
      ]
    },
    "ProgressKind": {
      "type": "string",
      "enum": [
        "tool",
        "shell",
        "text"
      ]
    },
    "InFlight": {
      "type": "string",
      "enum": [
        "tool",
        "shell"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "$ref": "#/definitions/Role"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "maxLength": 1000000
        }
      },
      "required": [
        "id",
        "role",
        "order",
        "created_at",
        "updated_at",
        "text"
      ],
      "additionalProperties": false
    },
    "Role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "archived": {
          "type": "boolean"
        },
        "visible_before": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "archived",
        "visible_before",
        "deleted"
      ],
      "additionalProperties": false
    },
    "Batch": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "$ref": "#/definitions/BatchKind"
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "through": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "upload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chunk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        },
        "session": {
          "$ref": "#/definitions/Session"
        },
        "messages": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Message"
          }
        },
        "delete_ids": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "version",
        "batch_id",
        "session_id",
        "kind",
        "from",
        "through",
        "session",
        "messages",
        "delete_ids"
      ],
      "additionalProperties": false
    },
    "BatchKind": {
      "type": "string",
      "enum": [
        "baseline",
        "delta",
        "replace"
      ]
    },
    "ReadContext": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "anchor_order": {
          "type": "integer",
          "minimum": -1,
          "maximum": 9007199254740991
        },
        "anchor_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "prefix_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "visible_before": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "anchor_order",
        "anchor_bytes",
        "prefix_hash",
        "visible_before"
      ],
      "additionalProperties": false
    },
    "CursorPointer": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session_id",
        "cursor"
      ],
      "additionalProperties": false
    },
    "CursorRequest": {
      "type": "object",
      "properties": {
        "sessions": {
          "maxItems": 4000,
          "type": "array",
          "items": {
            "$ref": "#/definitions/CursorPointer"
          }
        }
      },
      "required": [
        "sessions"
      ],
      "additionalProperties": false
    },
    "CheckedRequest": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "behind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "behind_since": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "EmptyRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "AckRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/definitions/AckStatus"
        }
      },
      "required": [
        "operation_id",
        "message_id",
        "status"
      ],
      "additionalProperties": false
    },
    "AckStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "needs_confirmation",
        "failed"
      ]
    },
    "StartAckRequest": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/definitions/StartAckStatus"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z_]{1,40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "status",
        "session_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "StartAckStatus": {
      "type": "string",
      "enum": [
        "started",
        "created_not_started",
        "failed",
        "uncertain"
      ]
    },
    "VerifyRequest": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session_id",
        "hash"
      ],
      "additionalProperties": false
    },
    "PairStart": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,100}$"
        },
        "database_epoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,100}$"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "device_id",
        "database_epoch",
        "label"
      ],
      "additionalProperties": false
    },
    "PairToken": {
      "type": "object",
      "properties": {
        "device_code": {
          "type": "string"
        }
      },
      "required": [
        "device_code"
      ],
      "additionalProperties": false
    },
    "ArtifactUpload": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\x00-\\x1f\\x7f]+$"
        },
        "mime_type": {
          "$ref": "#/definitions/MimeType"
        },
        "blob": {
          "type": "string",
          "minLength": 4,
          "maxLength": 682668,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "artifact_id",
        "session_id",
        "title",
        "name",
        "mime_type",
        "blob",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "MimeType": {
      "type": "string",
      "enum": [
        "text/html",
        "text/plain",
        "image/png",
        "image/jpeg",
        "application/pdf",
        "application/zip"
      ]
    }
  },
  "title": "BridgeContracts"
}
